+            for(CompositionEngine c:Arrays.asList(eager,paged)) {c.start(false,false,false,false,true);c.englishOptions(true,true);c.candidateDisplay(s->allow || s.equals("teh"));typeWithoutFullRead(c,"teh");}
+            eager.candidates();eager.space();paged.space();equal(a.text,b.text,"Correction Space parity");
+            eager.backspace();paged.backspace();equal(a.text,b.text,"Correction undo text parity");equal(a.composing,b.composing,"Correction undo spelling parity");
+        }
+        AddonDictionary addons=AddonDictionary.read(new StringReader("poj\tfixture\ttâi-gí\ttest\tfixture\njapanese\tfixture\tかな\ttest\tfixture\n"));
+        for(InputMode mode:InputMode.values()) {
+            Editor output=new Editor();CompositionEngine c=engine(output,Learning.NONE,false);
+            c.addons(addons,new HashSet<>(Arrays.asList("poj","japanese")));c.switchMode(mode,false);c.candidateDisplay(s->true);
