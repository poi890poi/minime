@@ -0,0 +1,78 @@
+package dev.minime.core;
+
+import java.util.*;
+import java.util.function.Predicate;
+import static dev.minime.core.Regression.*;
+
+final class CandidatePageRegression {
+    // Independent oracle: the original complete filter, without paging helpers.
+    static List<Candidate> eager(List<Candidate> source,boolean raw,Predicate<String> supported) {
+        List<Candidate> result=new ArrayList<>();
+        for(int i=0;i<source.size();i++) {
+            Candidate c=raw && i==0?source.get(i):source.get(i).readable(supported);
+            if(c!=null)result.add(c);
+        }
+        return result;
+    }
+    static String identity(Candidate c) {
+        return c.text+"|"+c.literal+"|"+c.score+"|"+c.reading+"|"+c.consumed+"|"+c.supplemental
+            +"|"+c.abbreviated+"|"+c.composed+"|"+c.incomplete+"|"+c.pack+"|"+c.languageCharacter
+            +"|"+c.transliteration+"|"+c.alternateText()+"|"+(c.pair==null?"":c.pair.source);
+    }
+    static void same(List<Candidate> a,List<Candidate> b,String message) {
+        equal(a.size(),b.size(),message+" count");
+        for(int i=0;i<a.size();i++)equal(identity(a.get(i)),identity(b.get(i)),message+" candidate "+i);
+    }
+    static void run() {
+        Random random=new Random(0x4d494e494d45L);
+        int cases=0;
+        for(int n:new int[]{0,1,2,7,25,129,2048})for(int policy=0;policy<7;policy++)for(boolean raw:new boolean[]{false,true}) {
+            List<Candidate> ranked=new ArrayList<>();
+            for(int i=0;i<n;i++) {
+                String text="entry"+random.nextInt(100000);
+                Candidate c=new Candidate(text,i==0,random.nextDouble(),i%5==0?2:0);
+                if(i%3==0)c=c.paired(new PairedForms.Pair(text,"form"+i,"fixture:"+i)).inPack("poj");
+                if(i%7==0)c=c.completing(c.score).asConstructed();
+                ranked.add(c);
+            }
+            final int rule=policy;
+            Predicate<String> allowed=s->rule==0 || (rule!=1 && Math.floorMod(s.hashCode(),rule+1)!=0);
+            List<Candidate> expected=eager(ranked,raw,allowed);
+            for(int choice:new int[]{0,Math.min(1,n-1),n/2,n-1}) {
+                if(choice<0)continue;
+                int preferred=0;
+                if(n>0) {
+                    Candidate original=ranked.get(choice);
+                    Candidate transformed=raw && choice==0?original:original.readable(allowed);
+                    if(transformed!=null) {
+                        preferred=eager(ranked.subList(0,choice),raw,allowed).size();
+                    }
+                }
+                CandidatePage page=new CandidatePage(ranked,choice,raw,allowed);
+                equal(preferred,page.preferred,"Same default after unreadable runs and paired fallback");
+                equal(n==0 || expected.contains(ranked.get(choice)),page.originalPreferredRetained,"Same correction eligibility");
+                List<Candidate> retained=page.first(3);
+                String retainedBefore=retained.toString();
+                for(int size:new int[]{0,1,2,8,24,25,48,10000,7})same(expected.subList(0,Math.min(size,expected.size())),page.first(size),"Eager prefix");
+                equal(retainedBefore,retained.toString(),"Older prefix remains stable");
+                same(expected,page.all(),"Full union preserved");
+                equal(null,page.at(expected.size()),"Past end is unavailable");
+                cases++;
+            }
+        }
+        List<Candidate> many=new ArrayList<>();
+        for(int i=0;i<4096;i++)many.add(new Candidate("entry"+i,false,i));
+        int[] probes={0};
+        CandidatePage page=new CandidatePage(many,1,true,s->{probes[0]++;return true;});
+        equal(1,probes[0],"Construction validates Space, not off-screen tail");
+        List<Candidate> first=page.first(26);
+        equal(25,probes[0],"25 font probes for 26 entries including protected raw");
+        equal(many.get(12),page.find(c->c==many.get(12)),"Visible selection keeps identity");
+        equal(25,probes[0],"Visible selection does not scan tail");
+        many.clear();
+        equal(4096,page.all().size(),"Source snapshot independent of its former owner");
+        equal(26,first.size(),"Old page remains its original size");
+        equal(4095,probes[0],"All candidates checked once when eventually requested");
+        System.out.println("PASS candidate pages: "+cases+" generated eager-oracle cases; deferred probes 25/4095 before expansion");
+    }
+}
