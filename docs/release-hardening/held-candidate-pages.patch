diff --git a/core/src/main/java/dev/minime/core/CandidatePage.java b/core/src/main/java/dev/minime/core/CandidatePage.java
new file mode 100644
--- /dev/null
+++ b/core/src/main/java/dev/minime/core/CandidatePage.java
@@ -0,0 +1,64 @@
+package dev.minime.core;
+
+import java.util.*;
+import java.util.function.Predicate;
+
+/** One ranked result, with ordered font validation on demand. Owned by one UI thread. */
+public final class CandidatePage {
+    private final List<Candidate> source;
+    private final Predicate<String> supported;
+    private final boolean protectRaw;
+    private final List<Candidate> readable=new ArrayList<>();
+    private int cursor;
+    final int preferred;
+    final boolean originalPreferredRetained;
+
+    CandidatePage(List<Candidate> ranked,int preferred,boolean protectRaw,Predicate<String> supported) {
+        source=new ArrayList<>(ranked);this.supported=supported;this.protectRaw=protectRaw;
+        int selected=0;
+        for(int i=0;i<source.size() && i<=preferred;i++) {
+            int before=readable.size();advance();
+            if(i==preferred && readable.size()>before)selected=before;
+        }
+        // Even an idle result whose leading candidates are unreadable needs its
+        // first surviving choice before callers inspect emptiness or default.
+        ensure(1);
+        this.preferred=selected;
+        originalPreferredRetained=source.isEmpty() || readable.contains(source.get(preferred));
+    }
+
+    private void advance() {
+        int at=cursor++;
+        Candidate value=source.get(at);
+        if(supported!=null && !(protectRaw && at==0))value=value.readable(supported);
+        if(value!=null)readable.add(value);
+    }
+    private void ensure(int count) {
+        while(readable.size()<count && cursor<source.size())advance();
+    }
+    /** Stable prefix; the next request cannot mutate an earlier returned list. */
+    public List<Candidate> first(int count) {
+        if(count<0)throw new IllegalArgumentException("Negative candidate count");
+        ensure(count);
+        return Collections.unmodifiableList(new ArrayList<>(readable.subList(0,Math.min(count,readable.size()))));
+    }
+    /** Complete compatibility path, including candidates beyond the current viewport. */
+    public List<Candidate> all() {
+        ensure(Integer.MAX_VALUE);
+        return Collections.unmodifiableList(readable);
+    }
+    Candidate at(int index) {
+        if(index<0)return null;
+        ensure(index==Integer.MAX_VALUE?index:index+1);
+        return index<readable.size()?readable.get(index):null;
+    }
+    Candidate find(Predicate<Candidate> matches) {
+        for(int i=0;;i++) {
+            Candidate value=at(i);
+            if(value==null || matches.test(value))return value;
+        }
+    }
+    // Engine acceptance consults only the already-resolved default. This list is
+    // never exposed to a caller that could mutate it or infer the final count.
+    List<Candidate> prepared() {return readable;}
+}
