+package dev.minime.ime;
+
+import android.app.Activity;
+import android.graphics.Rect;
+import android.test.ActivityInstrumentationTestCase2;
+import android.view.*;
+import android.widget.*;
+import dev.minime.core.*;
+import java.io.StringReader;
+import java.util.*;
+import java.util.function.Consumer;
+import java.util.concurrent.TimeUnit;
+
+/** Generated view/acceptance fixtures, never a vocabulary quality benchmark. */
+@SuppressWarnings("deprecation")
+public abstract class ExpandedCandidatePagingContract<T extends Activity> extends ActivityInstrumentationTestCase2<T> {
+    protected ExpandedCandidatePagingContract(Class<T> activity){super(activity);}
+    private KeyboardView board;private CompositionEngine engine;
+    private final StringBuilder accepted=new StringBuilder();
+    private boolean defer;private Runnable reply;
+    private void main(Runnable action){getInstrumentation().runOnMainSync(action);}
+    private void idle(){getInstrumentation().waitForIdleSync();}
+    private View find(View view,String description) {
+        if(description.contentEquals(view.getContentDescription()==null?"":view.getContentDescription()))return view;
+        if(view instanceof ViewGroup)for(int i=0;i<((ViewGroup)view).getChildCount();i++) {
+            View found=find(((ViewGroup)view).getChildAt(i),description);if(found!=null)return found;
+        }
+        return null;
+    }
+    private void render(){board.render(engine,false,false,false,0,false,false,false,true,true,"Enter","");}
+    private ScrollView scroll(){return (ScrollView)find(board,"Expanded candidate list");}
+    private ViewGroup grid(){return (ViewGroup)scroll().getChildAt(0);}
+    private List<String> identities() {
+        List<String> out=new ArrayList<>();for(Candidate c:engine.candidates())out.add(c.text+"\t"+c.alternateText()+"\t"+c.literal+"\t"+c.consumed);
+        return out;
+    }
+    private void setup(boolean paired)throws Exception {
+        Activity activity=getActivity();
+        PhoneticDictionary dictionary=DictionaryRepository.load(activity).get(30,TimeUnit.SECONDS);
+        List<Candidate> choices=new ArrayList<>();
+        if(paired) {
+            StringBuilder words=new StringBuilder(),pairs=new StringBuilder();List<String> keys=new ArrayList<>(),texts=new ArrayList<>();
+            for(int i=0;i<256;i++) {
+                String key="zavora"+(char)('a'+i/26)+(char)('a'+i%26),text=key+(i%9==0?"-zava-zava":""),han="測試"+Integer.toBinaryString(i).replace('0','甲').replace('1','乙');
+                keys.add(key);texts.add(text);words.append("poj\t"+key+"\t"+text+"\titaigi:"+i+"\tfixture\n");
+                pairs.append("poj\t"+text+"\t"+han+"\titaigi:"+i+"\n");
+            }
+            AddonDictionary source=AddonDictionary.read(new StringReader(words.toString()),PairedForms.read(new StringReader(pairs.toString())));
+            for(int i=0;i<256;i++) {
+                String text=texts.get(i);Candidate value=source.lookup(keys.get(i),Collections.singleton("poj")).stream().filter(c->c.text.equals(text)).findFirst().get();
+                assertNotNull(value.pair);choices.add(value);
+            }
+        } else for(int i=0;i<256;i++)choices.add(new Candidate((i%9==0?"較長的測試候選文字":"測試")+String.format(Locale.ROOT,"%03d",i),false,1000-i));
+        main(()-> {
+            board=new KeyboardView(activity,key->{},key->false,(points,caps)->{});
+            engine=new CompositionEngine(new CompositionEngine.Editor() {
+                public void composing(String s){}public void commit(String s){accepted.append(s);}
+                public void delete(){}public void enter(){}public void finish(){}
+            },Learning.NONE);
+            engine.dictionary(dictionary);engine.start(false,false,false,false);
+            if(paired){engine.addons(AddonDictionary.EMPTY,Collections.singleton("poj"));engine.switchMode(InputMode.TAIWANESE_ENGLISH,false);}
+            engine.decoder(new CompositionEngine.Decoder() {
+                public void convert(PhoneticDictionary d,String r,boolean z,String c,Consumer<List<Candidate>> done){throw new AssertionError("query override");}
+                public void query(PhoneticDictionary d,String r,boolean z,String c,boolean p,AddonDictionary a,Set<String> enabled,Consumer<List<Candidate>> done) {
+                    Runnable deliver=()->done.accept(new ArrayList<>(choices));if(defer)reply=deliver;else deliver.run();
+                }
+            },this::render);
+            activity.setContentView(board);engine.type('a');render();
+        });idle();
+    }
+    private void expand(){main(()->assertTrue(find(board,"Expand candidates").performClick()));idle();}
+    private Candidate tail() {List<Candidate> all=engine.candidates();return all.get(all.size()-1);}
+    private Candidate pairedTail() {return engine.candidates().stream().filter(c->c.pair!=null).reduce((a,b)->b).get();}
+    private void reach(Candidate value)throws Exception {
+        String description="Candidate "+value.text;boolean[] visible={false};
+        long deadline=android.os.SystemClock.uptimeMillis()+8000;
+        while(!visible[0] && android.os.SystemClock.uptimeMillis()<deadline) {
+            main(()->{ScrollView s=scroll();assertNotNull(s);s.setSmoothScrollingEnabled(false);s.fullScroll(View.FOCUS_DOWN);});idle();
+            main(()->{View v=find(board,description);visible[0]=v!=null && v.getGlobalVisibleRect(new Rect());});
+            if(!visible[0])android.os.SystemClock.sleep(16);
+        }
+        assertTrue("Tail is visible after scrolling, not merely allocated",visible[0]);
+    }
+    public void testExpandedTailTapAndReset()throws Exception {
+        setup(false);expand();Candidate[] last={null};View[] first={null};List<List<String>> before=new ArrayList<>();
+        main(()-> {
+            last[0]=tail();before.add(identities());first[0]=grid().getChildAt(0);
+            assertNull("Initial expansion does not allocate the distant tail",find(board,"Candidate "+last[0].text));
+            assertTrue("Initial batch can scroll and expose another page",grid().getHeight()>scroll().getHeight());
+        });
+        reach(last[0]);
+        main(()->{assertEquals(before.get(0),identities());assertSame("Append preserves earlier accessibility view identity",first[0],grid().getChildAt(0));
+            assertTrue(find(board,"Collapse candidates").performClick());});idle();expand();
+        main(()->assertNull("Reopen starts with bounded allocation",find(board,"Candidate "+last[0].text)));
+        reach(last[0]);main(()->{assertTrue(find(board,"Candidate "+last[0].text).performClick());assertEquals(last[0].text,accepted.toString());
+            accepted.setLength(0);engine.type('b');render();});idle();expand();
+        main(()->{assertNull("New input resets allocation",find(board,"Candidate "+tail().text));
+            Candidate choice=engine.candidates().get(engine.preferred());String expected=choice.text+(choice.literal?" ":"");engine.space();assertEquals("Paging cannot change Space default",expected,accepted.toString());});
+    }
+    public void testExpandedPairedHoldAndPendingSelection()throws Exception {
+        setup(true);expand();Candidate[] last={null};main(()->{last[0]=pairedTail();assertNull("Distant paired choice starts offscreen",find(board,"Candidate "+last[0].text));});assertFalse(last[0].alternateText().isEmpty());reach(last[0]);
+        main(()->{assertTrue(find(board,"Candidate "+last[0].text).performLongClick());assertEquals(last[0].alternateText(),accepted.toString());
+            accepted.setLength(0);engine.type('b');render();});idle();expand();
+        main(()->{last[0]=pairedTail();defer=true;engine.type('c');render();assertTrue(engine.predictionPending());});
+        reach(last[0]);
+        main(()->{View stale=find(board,"Candidate "+last[0].text);assertTrue(stale.performClick());assertEquals("Pending selection waits", "",accepted.toString());
+            assertNotNull(reply);defer=false;reply.run();assertEquals(last[0].text,accepted.toString());
+            accepted.setLength(0);engine.start(false,false,false,false);engine.type('d');render();
+            stale.performClick();assertEquals("Old composition cannot accept into a new editor", "",accepted.toString());});
+    }
+}
