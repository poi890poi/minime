@@ -0,0 +1,47 @@
+package dev.minime.ime;
+
+import android.content.*;
+import android.test.InstrumentationTestCase;
+import java.io.*;
+import java.util.*;
+import java.util.function.ToIntFunction;
+
+/** Persistence parity and isolated lookup cost; fixtures are not language-quality data. */
+@SuppressWarnings("deprecation")
+public final class LearningCounterTest extends InstrumentationTestCase {
+    public void testLiveBindingAndLookupCost()throws Exception {
+        Context context=getInstrumentation().getTargetContext();
+        SharedPreferences data=context.getSharedPreferences("learning",0);
+        // The guarded runner backs up/restores the complete original store.
+        LocalLearning learning=new LocalLearning(context);
+        try(PrintWriter out=new PrintWriter(new File(context.getExternalFilesDir(null),"learning-counter.tsv"),"UTF-8")) {
+            out.println("store_size\tround\tcandidates\told_ns\tbound_ns\tchecksum");
+            for(int size:new int[]{0,20,2000}) {
+                SharedPreferences.Editor edit=data.edit().clear();
+                for(int i=0;i<size;i++)edit.putInt("context\treading\tchoice-"+i,i%101);
+                assertTrue(edit.commit());
+                for(String c:Arrays.asList("context","別の文脈",""))for(String r:Arrays.asList("reading","𠀀'a","")) {
+                    ToIntFunction<String> bound=learning.counter(c,r);
+                    for(String value:Arrays.asList("choice-0","choice-19","choice-1999","かな","tâi",""))
+                        assertEquals(learning.count(c,r,value),bound.applyAsInt(value));
+                }
+                List<String> values=new ArrayList<>();for(int i=0;i<512;i++)values.add("choice-"+(i*7%2200));
+                for(int round=-5;round<20;round++) {
+                    long a,b,start;int x=0,y=0;
+                    if((round&1)==0) {
+                        start=System.nanoTime();for(String value:values)x+=learning.count("context","reading",value);a=System.nanoTime()-start;
+                        start=System.nanoTime();ToIntFunction<String> bound=learning.counter("context","reading");for(String value:values)y+=bound.applyAsInt(value);b=System.nanoTime()-start;
+                    } else {
+                        start=System.nanoTime();ToIntFunction<String> bound=learning.counter("context","reading");for(String value:values)y+=bound.applyAsInt(value);b=System.nanoTime()-start;
+                        start=System.nanoTime();for(String value:values)x+=learning.count("context","reading",value);a=System.nanoTime()-start;
+                    }
+                    assertEquals(x,y);if(round>=0)out.println(size+"\t"+round+"\t"+values.size()+"\t"+a+"\t"+b+"\t"+x);
+                }
+                ToIntFunction<String> live=learning.counter("context","reading");
+                assertTrue(data.edit().putInt("context\treading\tかな",37).commit());assertEquals(37,live.applyAsInt("かな"));
+                assertTrue(data.edit().clear().commit());assertEquals(0,live.applyAsInt("かな"));
+                assertTrue(data.edit().putInt("context\treading\tかな",19).commit());assertEquals(19,live.applyAsInt("かな"));
+            }
+        }
+    }
+}
