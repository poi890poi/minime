@@ -0,0 +1,30 @@
+package dev.minime.core;
+
+import java.util.*;
+import java.util.function.ToIntFunction;
+import static dev.minime.core.Regression.*;
+
+final class LearningCounterRegression {
+    static void run() {
+        Memory memory=new Memory();
+        for(String context:Arrays.asList("","EN_NEXT","FOCUS:poj","前文"))for(String raw:Arrays.asList("","abc","𠀀","a'b")) {
+            ToIntFunction<String> bound=memory.counter(context,raw);
+            for(String choice:Arrays.asList("","甲","かな","tâi","𠀀")) {
+                equal(memory.count(context,raw,choice),bound.applyAsInt(choice),"binding matches original lookup");
+                memory.choose(context,raw,choice);
+                equal(memory.count(context,raw,choice),bound.applyAsInt(choice),"binding observes subsequent vote");
+                memory.votes.clear();
+                equal(0,bound.applyAsInt(choice),"binding observes cleared storage");
+            }
+        }
+        Learning forbidden=new Learning() {
+            public int count(String c,String r,String v){throw new AssertionError("Private input read learning");}
+            public ToIntFunction<String> counter(String c,String r){throw new AssertionError("Private input bound learning");}
+            public void choose(String c,String r,String v){throw new AssertionError("Private input stored learning");}
+        };
+        Editor editor=new Editor();CompositionEngine e=new CompositionEngine(editor,forbidden);
+        e.dictionary(dictionary);e.start(false,false,true,false);
+        e.decoder((d,r,b,c,done)->done.accept(Arrays.asList(new Candidate("甲乙",false,10),new Candidate("丙丁",false,9))),()->{});
+        type(e,"nihao");e.space();equal("甲乙",editor.text,"private sort and acceptance remain independent of learning");
+    }
+}
