diff --git a/core/src/main/java/dev/minime/core/CompositionEngine.java b/core/src/main/java/dev/minime/core/CompositionEngine.java
index e718965..03860f4 100644
--- a/core/src/main/java/dev/minime/core/CompositionEngine.java
+++ b/core/src/main/java/dev/minime/core/CompositionEngine.java
@@ -635,6 +635,17 @@ public final class CompositionEngine {
                 Candidate c=candidates.get(i);
                 if(!c.literal && !partial(c) && !c.composed
                         && c.text.codePoints().anyMatch(cp->Character.UnicodeScript.of(cp)==Character.UnicodeScript.HAN)) {
+                    // Prefer a reading covering every source unit over a
+                    // forward completion. Swap only Chinese positions so
+                    // English access and the raw Space default stay stable.
+                    if(c.incomplete && !c.abbreviated)for(int j=i+1;j<candidates.size();j++) {
+                        Candidate match=candidates.get(j);
+                        if(!match.literal && !partial(match) && !match.composed
+                                && (!match.incomplete || match.abbreviated)
+                                && match.text.codePoints().anyMatch(cp->Character.UnicodeScript.of(cp)==Character.UnicodeScript.HAN)) {
+                            Collections.swap(candidates,i,j);break;
+                        }
+                    }
                     candidates.add(1,candidates.remove(i));break;
                 }
             }
